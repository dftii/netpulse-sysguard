# Frontend configuration template.
# Copy this file to frontend/.env.local and adjust the values. Vite reads .env.local
# at startup, so restart `npm run dev` after changing it. Only variables prefixed with
# VITE_ are exposed to the browser bundle. Do not put secrets here: everything in the
# bundle is public.

# Base URL of the FastAPI backend (REST API and the /ws/telemetry WebSocket).
# Used by the backend data mode. Default: http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000

# Data source used at startup:
#   auto        probe GET /api/health (1.5 s timeout). Use the backend if it answers,
#               otherwise the in-browser simulation engine.
#   backend     always use the FastAPI backend.
#   simulation  always use the in-browser simulation engine. No backend is needed.
# With auto, a manual choice made in the dashboard header is remembered in the browser
# (localStorage key "netpulse.mode"); a forced backend/simulation value always wins at startup.
# Default: auto
VITE_DEFAULT_MODE=auto
