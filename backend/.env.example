# NetPulse SysGuard backend configuration.
# Copy this file to backend/.env and adjust values. Every variable is optional:
# when a variable is unset, the built-in default shown here is used.
# Values are read by app/config.py, where each field maps to NETPULSE_<FIELD_NAME>.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NETPULSE_APP_NAME="NetPulse SysGuard"
NETPULSE_APP_VERSION="1.0.0"
# Free-form label shown by the health endpoint (development, staging, production).
NETPULSE_ENVIRONMENT=development
# Python logging level: DEBUG, INFO, WARNING, ERROR.
NETPULSE_LOG_LEVEL=INFO
# JSON list of origins allowed to call the API from a browser.
NETPULSE_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLAlchemy URL. The default points to backend/data/netpulse.db.
# Uncomment to override, for example:
# NETPULSE_DATABASE_URL=sqlite+aiosqlite:///./data/netpulse.db
# Log every SQL statement to the console (verbose, debugging only).
NETPULSE_DATABASE_ECHO=false

# ---------------------------------------------------------------------------
# Telemetry pipeline
# ---------------------------------------------------------------------------
# Seconds between telemetry ticks (allowed range: above 0.1 and up to 60).
NETPULSE_TELEMETRY_INTERVAL_SECONDS=1.0
# Persist one metric sample to the database every N ticks.
NETPULSE_METRICS_PERSIST_EVERY_N_TICKS=5
# Days of metric samples kept before the retention job deletes them.
NETPULSE_METRICS_RETENTION_DAYS=7
# Seconds between runs of the retention job (minimum 60).
NETPULSE_RETENTION_CHECK_INTERVAL_SECONDS=3600
# Link capacity assumed for the host node, in Mbps. Used to compute bandwidth saturation.
NETPULSE_HOST_LINK_CAPACITY_MBPS=1000.0
# Remote endpoint used to measure network latency.
NETPULSE_LATENCY_PROBE_HOST=1.1.1.1
NETPULSE_LATENCY_PROBE_PORT=443
# Seconds to wait for each latency probe before counting it as failed.
NETPULSE_LATENCY_PROBE_TIMEOUT_SECONDS=1.0

# ---------------------------------------------------------------------------
# Enterprise cluster simulator
# ---------------------------------------------------------------------------
# Generate simulated nodes and metrics alongside the real host.
NETPULSE_ENABLE_SIMULATOR=true
# Optional integer seed for reproducible simulation runs. Unset means random.
# NETPULSE_SIMULATOR_SEED=42
# Probability (0.0 to 1.0) that a simulated node starts an incident on each tick.
NETPULSE_SIMULATOR_INCIDENT_PROBABILITY=0.0015

# ---------------------------------------------------------------------------
# Anomaly detection engine
# ---------------------------------------------------------------------------
# Number of recent samples kept per metric for baseline calculations (10 to 3600).
NETPULSE_ANOMALY_WINDOW_SIZE=60
# Minimum samples required before z-score detection starts.
NETPULSE_ANOMALY_MIN_SAMPLES=20
# Z-score above which a reading is flagged as anomalous.
NETPULSE_ANOMALY_ZSCORE_THRESHOLD=3.0
# CPU percentage that is always treated as critical.
NETPULSE_ANOMALY_CPU_CRITICAL_PERCENT=90.0
# Number of samples used to fit the memory-leak trend line (20 to 3600).
NETPULSE_ANOMALY_MEMORY_LEAK_WINDOW=90
# Minimum slope of the memory trend line required to report a leak.
NETPULSE_ANOMALY_MEMORY_LEAK_MIN_SLOPE=0.08
# Minimum R-squared (0 to 1) of the trend fit before a leak is reported.
NETPULSE_ANOMALY_MEMORY_LEAK_MIN_R2=0.85
# Bandwidth utilisation percentage that counts as saturation.
NETPULSE_ANOMALY_BANDWIDTH_SATURATION_PERCENT=85.0
# Latency in milliseconds that is always treated as critical.
NETPULSE_ANOMALY_LATENCY_CRITICAL_MS=250.0
# Disk usage percentage that is always treated as critical.
NETPULSE_ANOMALY_DISK_CRITICAL_PERCENT=92.0
# Temperature (Celsius) that raises a THERMAL_SPIKE warning / critical alert.
NETPULSE_ANOMALY_TEMPERATURE_WARNING_C=80.0
NETPULSE_ANOMALY_TEMPERATURE_CRITICAL_C=90.0
# Consecutive OFFLINE samples before a SERVICE_DOWN alert is raised (1 to 600).
NETPULSE_ANOMALY_SERVICE_DOWN_SAMPLES=3
# Seconds before the same anomaly on the same node can raise a new alert.
NETPULSE_ANOMALY_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------
# Port scanner
# ---------------------------------------------------------------------------
# Default per-port connection timeout in seconds (above 0 and up to 10).
NETPULSE_SCAN_DEFAULT_TIMEOUT_SECONDS=0.8
# Maximum number of ports probed in parallel.
NETPULSE_SCAN_MAX_CONCURRENCY=200
# Maximum number of ports a single audit may scan.
NETPULSE_SCAN_MAX_PORTS=1024
# Allow audits of public (non-private) IP addresses. Keep false unless you own the target.
NETPULSE_SCAN_ALLOW_PUBLIC_TARGETS=false
# Read a service banner from open ports when possible.
NETPULSE_SCAN_BANNER_GRAB=true

# ---------------------------------------------------------------------------
# WebSocket
# ---------------------------------------------------------------------------
# Maximum number of simultaneous telemetry WebSocket clients.
NETPULSE_WS_MAX_CLIENTS=50
